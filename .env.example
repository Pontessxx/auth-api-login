PSQL__USER=admin
PSQL__PASS=changeme
PSQL__DB=auth_api_login
PSQL__PORT=5433

# Gere uma chave forte e aleatória (>= 32 bytes), nunca reutilize a de outro ambiente.
# Ex.: openssl rand -base64 64
JWT_KEY=
JWT_ISSUER=auth-api-login
JWT_AUDIENCE=auth-api-login-clients
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_MAX_ACTIVE_SESSIONS_PER_USER=5

# Usuário admin criado automaticamente no start da API, se ainda não existir.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
